      "id": "file:backend/src/knowledge-extraction/knowledge-extraction-resolution.service.ts",
      "type": "file",
      "name": "knowledge-extraction-resolution.service.ts",
      "filePath": "backend/src/knowledge-extraction/knowledge-extraction-resolution.service.ts",
      "summary": "Resolves a reviewed knowledge-extraction proposal into a new bubble, an update to an existing bubble, or a rejection, guarding with a resolution fingerprint for idempotent replay and an expected_updated_at precondition against concurrent target changes.",
      "tags": [
        "service",
        "workflow",
        "idempotency",
        "validation",
        "knowledge-extraction"
      ],
      "complexity": "complex",
      "languageNotes": "Resolution runs inside a database transaction and hashes the normalized input into a fingerprint, so a repeated request replays the stored outcome instead of creating a second bubble."
    },
