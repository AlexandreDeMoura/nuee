      "id": "file:backend/src/database/database.provider.ts",
      "type": "file",
      "name": "database.provider.ts",
      "filePath": "backend/src/database/database.provider.ts",
      "summary": "Owns the single application-scoped node:sqlite connection: resolves the configured database path, enables foreign keys and a 5s busy timeout, runs migrations at construction, and closes on shutdown.",
      "tags": [
        "database",
        "infrastructure",
        "sqlite",
        "migration",
        "lifecycle"
      ],
      "complexity": "simple",
      "languageNotes": "Constructor-time migration plus OnModuleDestroy close makes the connection lifecycle match the Nest container, so repositories can never observe an unmigrated schema."
    },
