      "name": "DocumentsPanel.tsx",
      "filePath": "frontend/src/documents/DocumentsPanel.tsx",
      "summary": "Main document-library panel: renders the upload control gated by the server policy, in-flight transfer rows with dismiss/retry, the document list with per-row processing status and retry, and switches to the inspection panel on selection. Emits document analytics and maintains a live status summary for screen readers.",
      "tags": ["component", "documents", "upload", "analytics", "accessibility"],
      "complexity": "complex",
      "languageNotes": "State lives in the injected `controller` (the useDocumentLibrary hook); the panel keeps only view-local selection and focus-restoration refs."
    },
