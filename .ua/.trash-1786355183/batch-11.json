      "name": "DocumentInspectionPanel.tsx",
      "filePath": "frontend/src/documents/DocumentInspectionPanel.tsx",
      "summary": "Detail view for a single document: fetches the full record through an injectable request function, renders metadata, processing status with retry, and the processed text for ready documents only. Guards the async detail load against project/document switches and invalid response shapes.",
      "tags": ["component", "documents", "inspection", "async-state", "accessibility"],
      "complexity": "complex",
      "languageNotes": "The detail request is injected as a prop typed `typeof getDocument`, so tests substitute a fake without module mocking."
    },
