{
  "nodes": [
    {
      "id": "document:shared/PRD/PRD_0.md",
      "type": "document",
      "name": "PRD_0.md",
      "filePath": "shared/PRD/PRD_0.md",
      "summary": "Foundational MVP product contract for Nuée: defines the shared vocabulary (project, bubble, discussion, document, project description, frozen context) and the core habit loop of focused discussion to user-approved bubble to bubble reuse. Establishes the principles every feature PRD must conform to and may not weaken, including explicit user approval before AI output becomes durable knowledge.",
      "tags": ["documentation", "product-requirements", "entry-point", "product-vision", "glossary"],
      "complexity": "moderate",
      "languageNotes": "Acts as the constitution of the PRD series: numbered success criteria plus an explicit in-scope/out-of-scope split, a pattern every later PRD repeats."
    },
    {
      "id": "document:shared/PRD/PRD_01.md",
      "type": "document",
      "name": "PRD_01.md",
      "filePath": "shared/PRD/PRD_01.md",
      "summary": "Specifies the Project Workspace: minimal project creation (title plus short description, no questionnaire or AI-generated starter content), project routing and persistence, the description editor with debounced autosave, and the single right-side panel shell that switches between Discussions, Documents, Project, and Inspector views.",
      "tags": ["documentation", "product-requirements", "project-workspace", "navigation-shell", "commit-plan"],
      "complexity": "moderate",
      "languageNotes": "First PRD to add a numbered Commit Plan, sequencing backend domain, entry surface, dialog, shell, editor, integration contracts, analytics, and an end-to-end journey test."
    },
    {
      "id": "document:shared/PRD/PRD_02.md",
      "type": "document",
      "name": "PRD_02.md",
      "filePath": "shared/PRD/PRD_02.md",
      "summary": "Specifies the Bubble Canvas as Nuée's primary durable-memory surface: an effectively infinite pan/zoom canvas, bubble cards with title and summary preview, manual bubble creation and editing, symmetric manual links without drawn connector lines, multi-selection handoff for other features, deterministic Compact layout, and persistence of positions and viewport.",
      "tags": ["documentation", "product-requirements", "canvas", "bubbles", "spatial-ui"],
      "complexity": "moderate",
      "languageNotes": "Explicitly refuses semantic meaning for bubble coordinates and excludes graph physics, keeping the canvas a free spatial arrangement rather than a knowledge graph."
    },
    {
      "id": "document:shared/PRD/PRD_03.md",
      "type": "document",
      "name": "PRD_03.md",
      "filePath": "shared/PRD/PRD_03.md",
      "summary": "Specifies Focused Discussions: a single visible modal above the canvas, immutable user and assistant messages, idempotent generation with retry of failed turns only, AI-generated titles with a deterministic placeholder fallback, and the last-activity ordering that drives the Discussions panel and the single Active discussion.",
      "tags": ["documentation", "product-requirements", "discussions", "ai-orchestration", "commit-plan"],
      "complexity": "complex",
      "languageNotes": "The commit plan is split into Phase A (backend), Phase B (frontend), and Phase C (cross-cutting close-out), with a dedicated section recording the seams and defaults decided for the MVP."
    },
    {
      "id": "document:shared/PRD/PRD_04.md",
      "type": "document",
      "name": "PRD_04.md",
      "filePath": "shared/PRD/PRD_04.md",
      "summary": "Specifies Discussion Context: the user explicitly chooses bubbles and whole documents before a discussion starts, the current project description is always included, and the selection is captured as immutable frozen snapshots at creation time. Later edits or deletions of the source never alter an existing discussion, and there is no mutation path for context after creation.",
      "tags": ["documentation", "product-requirements", "frozen-context", "immutability", "context-selection"],
      "complexity": "complex",
      "languageNotes": "Introduces the no-silent-truncation rule: an oversized context package blocks creation rather than dropping a selected source, making model input limits a user-visible constraint."
    },
    {
      "id": "document:shared/PRD/PRD_05.md",
      "type": "document",
      "name": "PRD_05.md",
      "filePath": "shared/PRD/PRD_05.md",
      "summary": "Specifies Knowledge Extraction, the bridge from temporary reasoning to durable memory: the user selects discussion messages and frozen-context items, the model returns exactly one structured proposal (title, summary, content), and the user reviews it before approving it as a new bubble, updating an existing bubble with optimistic-concurrency protection, or discarding it.",
      "tags": ["documentation", "product-requirements", "knowledge-extraction", "state-machine", "provenance"],
      "complexity": "complex",
      "languageNotes": "The longest PRD in the series: a thirteen-commit implementation plan with current-state findings, a proposed API and persistence shape, a success-criteria coverage audit, and acceptance caveats."
    },
    {
      "id": "document:shared/PRD/PRD_06.md",
      "type": "document",
      "name": "PRD_06.md",
      "filePath": "shared/PRD/PRD_06.md",
      "summary": "Specifies the Document Library: project-scoped upload with server-authoritative validation, private storage of the original under a server-generated key, malware scanning before text extraction, explicit processing states with retry, inspection in the Documents panel, and the readiness contract exposing only complete ready documents to Discussion Context.",
      "tags": ["documentation", "product-requirements", "documents", "file-processing", "security"],
      "complexity": "complex",
      "languageNotes": "Contains a security prerequisite section and a success-criteria traceability table, treating processing as the first durable job boundary with idempotency and generation guards."
    },
    {
      "id": "document:shared/PRD/PRD_07.md",
      "type": "document",
      "name": "PRD_07.md",
      "filePath": "shared/PRD/PRD_07.md",
      "summary": "Specifies per-turn opt-in web search for discussions: a composer toggle shown only when the provider supports it, a provider-neutral search flag and citation contract on the ModelClient port, an OpenAI Responses API adapter mapping, and citations persisted immutably on the assistant message and rendered as sanitized links.",
      "tags": ["documentation", "product-requirements", "web-search", "provider-neutral", "citations"],
      "complexity": "moderate",
      "languageNotes": "Deliberately confines provider specifics to the adapter so a future provider is an ai/ change rather than a discussions change; search never touches frozen context, title generation, or extraction."
    },
    {
      "id": "document:shared/PRD/PRD_08.md",
      "type": "document",
      "name": "PRD_08.md",
      "filePath": "shared/PRD/PRD_08.md",
      "summary": "Reworks the extraction request from PRD 05 into one deliberate Extract as bubble dialog with three ordered steps — what to include, optional free-text instructions, and a three-level detail choice — replacing whole-discussion selection with an explicit Select all and carrying the new parameters through to the prompt and the persisted attempt.",
      "tags": ["documentation", "product-requirements", "knowledge-extraction", "prompt-design", "iteration"],
      "complexity": "complex",
      "languageNotes": "A revision PRD: it names the shipped weakness it corrects (unbounded 900-word bubbles from a fixed prompt) and explicitly leaves everything downstream of Generate bubble to PRD 05."
    },
    {
      "id": "document:shared/PRD/PRD_09.md",
      "type": "document",
      "name": "PRD_09.md",
      "filePath": "shared/PRD/PRD_09.md",
      "summary": "Replaces PRD 04's four-surface context-selection flow with inline mentions in the draft composer: typing @ opens one searchable list of bubbles and documents, attachments become removable chips plus highlighted inline tokens, a persistent line counts what will freeze on send, and sending performs the handoff to the existing frozen badges.",
      "tags": ["documentation", "product-requirements", "mentions", "composer-ux", "supersedes"],
      "complexity": "complex",
      "languageNotes": "Supersedes only PRD 04's selection-flow criteria and UI while explicitly preserving its backend guarantees, and includes a decommissioning scope for the invitation, review, and takeover surfaces it removes."
    }
  ],
